import random
import string
# import sys

weak = ['123456', 'admin', '12345678', '123456789', '12345',
        'password', '123123', '111111', 'qwerty', 'abc123']

user_in = input("Do you want to generate a new password? (y/n): ")

if user_in.lower() == "y":

    while True:
        user_input = input("strong or weak? (strong/weak): ").lower()

        if user_input == "strong":
            target_length = random.randint(8, 12)

            # Step 1: guarantee one from each pool
            chars = [
                random.choice(string.digits),
                random.choice(string.ascii_uppercase),
                random.choice(string.ascii_lowercase),
                random.choice(string.punctuation),
            ]

            # Step 2: fill the rest from a combined pool
            combined = (string.digits + string.ascii_uppercase +
                        string.ascii_lowercase + string.punctuation)
            while len(chars) < target_length:
                chars.append(random.choice(combined))

            # Step 3: shuffle the LIST, then join
            random.shuffle(chars)
            print("Your strong password:", "".join(chars))
            break

        elif user_input == "weak":
            print("Your weak password:", random.choice(weak))
            break

        else:
            print("Invalid input. Try again.")

else:
    print("Session Terminated!")


# Or for function method

def build_strong_password(min_len=8, max_len=12):
    target = random.randint(min_len, max_len)

    pools = [string.digits, string.ascii_uppercase,
                 string.ascii_lowercase, string.punctuation]

        # Step 1: one guaranteed character from each pool
    chars = [random.choice(pool) for pool in pools]

        # Step 2: fill the rest from the combined pool
    combined = "".join(pools)
    while len(chars) < target:
        chars.append(random.choice(combined))

        # Step 3: shuffle so the guaranteed chars aren't at the front
    random.shuffle(chars)

    return "".join(chars)

print(build_strong_password())